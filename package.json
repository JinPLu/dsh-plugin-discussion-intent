{
  "name": "@jinplu/dsh-plugin-discussion-intent",
  "version": "0.1.0",
  "description": "Standalone DeepSeek Harness plugin for source-attested discussion intent, focus, and reviewable frame changes.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "discussion", "agent"],
  "license": "MIT",
  "author": "JinPLu",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": ["lib/", "cordis.patch.yml", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "import": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "import": "./lib/contract.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": [], "platform": "web" }
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.0.0", "pnpm": ">=10.0.0" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "pack:check": "pnpm build && npm pack --dry-run"
  },
  "peerDependencies": { "schemastery": "^3.18.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "schemastery": "^3.18.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
